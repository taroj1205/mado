#!/bin/sh
subject=$(head -n 1 "$1")
pattern='^((feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\([^)]+\)!?: .+|(Merge|Revert) .+|(fixup|squash)! .+)$'
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject must be 'type(scope): summary' (feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert)" >&2
  echo "got: $subject" >&2
  exit 1
fi
